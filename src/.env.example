# ADRS Environment Configuration
# Copy this file to .env and fill in your values

# Database connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adrs

# LLM API Keys (for evaluator extraction)
# Anthropic - required if using claude models (default)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI - required if using openai models
# OPENAI_API_KEY=sk-your-key-here

# Optional: Override the default model for evaluator extraction
# Default is anthropic/claude-sonnet-4-20250514
# EVALUATOR_EXTRACTION_MODEL=anthropic/claude-sonnet-4-20250514

# LiteLLM configuration (for code summarization and other LLM tasks)
# Optional: Override base URL for LiteLLM (e.g., for proxy or custom endpoint)
# LITELLM_BASE_URL=https://your-proxy.example.com
# Optional: Override the default model (default: aws/claude-sonnet-4-5)
# LITELLM_MODEL=aws/claude-sonnet-4-5
